# Pi3 production/live node
NODE_NAME=liquid-pi
STATE_DIR=/home/kristo/lrs_machine_watchdog

MIN_AVAILABLE_MIB=200
MAX_SWAP_USED_MIB=512
MAX_DISK_PERCENT=80
MAX_TEMP_C=75

REQUIRE_LRS001=yes
EXPECTED_LRS001_SOURCE=/dev/sda1
REQUIRE_COLLECTOR=yes

# Provision locally at deployment time. Do not commit real secrets.
NTFY_TOPIC=REPLACE_LOCALLY
HC_URL=REPLACE_LOCALLY
